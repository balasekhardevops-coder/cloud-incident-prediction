# Local Terraform cache and transient/secret-bearing artifacts
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
tfplan
*.tfplan
*.tfplan.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep .terraform.lock.hcl tracked after terraform init.
# Remote backend environment selection (do not commit local configuration)
backend.hcl
backend.*.hcl
!backend.hcl.example

# State backups, including pre-migration backups
*.tfstate.backup*
state-backup*/
